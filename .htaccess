# Включаем механизм перенаправлений
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Если запрашиваемый файл или папка существуют — не перенаправляем
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Все остальные запросы направляем в index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Запрещаем просмотр содержимого папок
Options -Indexes

# Запрет прямого доступа к чувствительным расширениям
<FilesMatch "\.(json|log|zip|bak|sql|env|ini|pepper)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# ===== SECURITY HEADERS =====
<IfModule mod_headers.c>
    # Запрет MIME-sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # Запрет встраивания в iframe (кликджекинг)
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Политика Referer
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Отключение ненужных браузерных API
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    
    # Скрыть X-Powered-By (дополнительно к php.ini)
    Header unset X-Powered-By
    
    # HSTS (только на HTTPS)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Скрыть версию PHP в заголовках
<IfModule mod_php7.c>
    php_flag expose_php Off
</IfModule>
<IfModule mod_php.c>
    php_flag expose_php Off
</IfModule>

# Скрыть ServerSignature (в .htaccess работает не всегда, нужен httpd.conf)
ServerSignature Off

# ===== КЕШИРОВАНИЕ СТАТИЧЕСКИХ РЕСУРСОВ =====
<IfModule mod_expires.c>
    ExpiresActive On

    # CSS/JS/шрифты фронта: все ссылки идут с ?v=filemtime - кеш «навсегда» безопасен.
    # Для админки правило перекрыто в config/.htaccess.
    ExpiresByType text/css               "access plus 1 year"
    ExpiresByType text/javascript        "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2             "access plus 1 year"
    ExpiresByType font/woff              "access plus 1 year"
    ExpiresByType font/ttf               "access plus 1 year"

    # Картинки: ?v= у загруженных файлов нет, имя при замене не меняется - 7 дней
    ExpiresByType image/jpeg    "access plus 7 days"
    ExpiresByType image/png     "access plus 7 days"
    ExpiresByType image/gif     "access plus 7 days"
    ExpiresByType image/webp    "access plus 7 days"
    ExpiresByType image/avif    "access plus 7 days"
    ExpiresByType image/svg+xml "access plus 7 days"
    ExpiresByType image/x-icon  "access plus 7 days"

    # HTML не кешируем: у CMS свой кеш страниц и clearPageCache()
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # immutable только там, где есть ?v=
    <FilesMatch "\.(css|js|woff2?|ttf|eot|otf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(jpe?g|png|gif|webp|avif|svg|ico)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

# ===== СЖАТИЕ =====
<IfModule mod_deflate.c>
    # Только текст: webp/jpg/png/zip/woff2 уже сжаты
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript text/javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>