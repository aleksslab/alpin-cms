# Запрет прямого доступа к файлам плагинов
<FilesMatch "\.(php|json|css|js)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Запрет листинга директорий
Options -Indexes